generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// Cliente registrado. Un cliente solo puede tener un BonoGanado en toda
// su vida (ver restricción @unique en BonoGanado.clienteId) — es la regla
// de negocio "un jugador no puede ganar más de un bono".
model Cliente {
  id             Int      @id @default(autoincrement())
  nombres        String
  apellidos      String
  docTipo        String
  docNumero      String   @unique
  nacimiento     DateTime
  telefono       String
  departamento   String
  ciudad         String
  email          String   @unique
  passwordHash   String
  createdAt      DateTime @default(now())

  consentimientos Consentimiento[]
  bono            BonoGanado?

  @@map("clientes")
}

// Registro auditable de cada aceptación legal del formulario de registro
// (términos, tratamiento de datos, mayoría de edad, condiciones de la
// promoción, comunicaciones opcionales). Queda fecha y versión del texto
// aceptado por si el texto legal cambia en el futuro.
model Consentimiento {
  id         Int      @id @default(autoincrement())
  clienteId  Int
  cliente    Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  tipo       String
  aceptado   Boolean
  version    String   @default("v1")
  aceptadoEn DateTime @default(now())

  @@index([clienteId])
  @@map("consentimientos")
}

// Division politica usada por el formulario de registro. Vive en base y no
// en un archivo del frontend para que se pueda corregir o ampliar sin
// desplegar, y sobre todo para poder VALIDAR contra ella: antes el backend
// aceptaba cualquier texto como departamento y ciudad.
model Departamento {
  id     Int    @id @default(autoincrement())
  nombre String @unique
  // Norte de Santander va de primero: es el departamento de las 3 sedes.
  orden  Int    @default(0)
  activo Boolean @default(true)

  municipios Municipio[]

  @@map("departamentos")
}

model Municipio {
  id             Int          @id @default(autoincrement())
  nombre         String
  departamentoId Int
  departamento   Departamento @relation(fields: [departamentoId], references: [id], onDelete: Cascade)
  // Dentro de Norte de Santander, los 6 del Area Metropolitana de Cucuta van
  // primero porque concentran casi todo el publico.
  orden          Int          @default(0)

  // Un mismo nombre puede repetirse entre departamentos (Rionegro existe en
  // Antioquia y en Santander), pero no dentro del mismo.
  @@unique([departamentoId, nombre])
  @@index([departamentoId])
  @@map("municipios")
}

// Visitante sin cuenta que gira la ruleta. Existe para poder limitar los
// giros: el endpoint es anonimo, asi que sin esto no hay forma de saber que
// dos giros vienen de la misma persona.
//
// El id viaja en una cookie httpOnly, de modo que el conteo lo lleva el
// servidor y no el navegador. Ver GIROS_MAXIMOS en ruleta.routes.ts.
model VisitanteAnonimo {
  id         String   @id
  giros      Int      @default(0)
  primerGiro DateTime @default(now())
  ultimoGiro DateTime @updatedAt
  // Se guarda solo para auditar abusos (muchas cookies distintas desde una
  // misma IP). No se usa para bloquear: en un casino con wifi compartido
  // dejaria por fuera a clientes legitimos.
  ip         String?

  @@index([ip])
  @@map("visitantes_anonimos")
}

// Los 3 casinos fisicos. Vive en base y no en codigo para que el select del
// cajero y la asignacion de premios salgan de la misma fuente, y para poder
// abrir o cerrar una sede sin desplegar.
//
// `clave` es el identificador estable (av-5, avenida-0, ventura-plaza): se
// usa en las relaciones y sobrevive a cambios de nombre comercial.
model Sede {
  id        Int     @id @default(autoincrement())
  clave     String  @unique
  nombre    String
  direccion String
  activo    Boolean @default(true)
  orden     Int     @default(0)

  premios  Premio[]
  canjes   BonoGanado[]
  usuarios Usuario[]

  @@map("sedes")
}

// Catálogo administrable de premios de la ruleta "Gira y Gana".
// `clave` es el identificador estable que el frontend usa para mapear
// cada premio a su ícono/color (esos datos visuales siguen viviendo en
// src/shared/data/prizes.ts, no se duplican aquí).
model Premio {
  id        Int          @id @default(autoincrement())
  clave     String       @unique
  nombre    String
  detalle   String       @db.Text
  monetario Boolean      @default(false)
  weight    Int
  activo    Boolean      @default(true)

  // Hasta cuando se puede redimir un bono de este premio. Es la fecha de la
  // campania; cada bono se lleva una copia al crearse (BonoGanado.vigenciaHasta)
  // para que extender la promocion no cambie lo que ya se le prometio a
  // alguien, ni acortarla invalide bonos entregados bajo otra condicion.
  vigenciaHasta DateTime

  // Sede donde se redime este premio. Al sortearse, el bono queda amarrado a
  // ese casino y al cliente le decimos exactamente a donde ir.
  //
  // Nullable porque hay premios que no se redimen en ninguna sede: el giro
  // adicional se resuelve en la misma ruleta y nunca genera bono.
  sedeId Int?
  sede   Sede? @relation(fields: [sedeId], references: [id])

  bonos BonoGanado[]

  @@index([sedeId])
  @@map("premios")
}

// El bono que un cliente ganó al girar la ruleta y reclamó al registrarse.
// clienteId es @unique: la base de datos, no solo el frontend, impide que
// un mismo jugador acumule más de un bono.
model BonoGanado {
  id            Int      @id @default(autoincrement())
  clienteId     Int      @unique
  cliente       Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  premioId      Int
  premio        Premio   @relation(fields: [premioId], references: [id])
  // @unique: la base es la que impide de verdad que dos bonos compartan
  // codigo. Ver generarCodigoCanje para como se reduce la probabilidad de
  // colision antes de llegar aqui.
  codigo        String   @unique
  estado        String   @default("pendiente") // pendiente | reclamado
  creadoEn      DateTime @default(now())
  // Copia de Premio.vigenciaHasta al momento de ganarlo. Pasada esta fecha el
  // cajero no puede canjearlo.
  vigenciaHasta DateTime
  canjeadoEn    DateTime?
  canjeadoPorId Int?
  canjeadoPor   Usuario? @relation(fields: [canjeadoPorId], references: [id])
  // Sede donde el cajero entrego fisicamente el bono. Puede diferir de la
  // sede del premio (Premio.sedeId): esa es donde se DEBE redimir, esta es
  // donde realmente se redimio. Guardar ambas es lo que permite detectar un
  // canje hecho en la sede equivocada.
  //
  // Nullable porque los canjes anteriores a esta columna no la tienen.
  sedeCanjeId   Int?
  sedeCanjeada  Sede? @relation(fields: [sedeCanjeId], references: [id])

  @@map("bonos_ganados")
}

// Cuentas de personal interno (no clientes). Entran por el mismo login del
// navbar; el rol decide a qué panel se les redirige tras autenticarse.
// No hay auto-registro: se siembran directamente (ver prisma/seed-staff.ts).
model Usuario {
  id           Int      @id @default(autoincrement())
  nombre       String
  email        String   @unique
  passwordHash String
  rol          String // 'admin' | 'cajero'
  activo       Boolean  @default(true)
  createdAt    DateTime @default(now())

  // Casino donde trabaja. Es lo que determina la sede que queda registrada al
  // canjear: el bono se entrego fisicamente donde esta la cajera, no donde
  // decia el premio. Guardar ambas cosas es lo que permite detectar que
  // alguien redimio en un casino distinto al asignado.
  //
  // Nullable porque el admin no pertenece a una sede concreta.
  sedeId Int?
  sede   Sede? @relation(fields: [sedeId], references: [id])

  canjes BonoGanado[]

  @@index([sedeId])
  @@map("usuarios")
}
