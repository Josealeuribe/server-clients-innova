# Local. En Render se usa la URI de Aiven, que exige TLS y limita conexiones:
# mysql://avnadmin:PASS@HOST.aivencloud.com:PUERTO/defaultdb?sslaccept=strict&connection_limit=5
DATABASE_URL="mysql://app_user:CHANGE_ME@localhost:3306/casino_innova"
PORT=4000
JWT_SECRET="generate-with-node-crypto-randomBytes-32-hex"
TICKET_SECRET="generate-a-different-one-the-same-way"
SESSION_TOKEN_TTL="7d"
TICKET_TTL_MINUTES=30
CORS_ORIGIN="http://localhost:8443"

# --- Correo (código de recuperación de contraseña de los clientes) ---
#
# SIN ESTAS VARIABLES NO SE CAE NADA: el flujo funciona igual y el código se
# imprime en el log del servidor (modo consola). Es lo que permite probar en
# local sin credenciales. Ver src/utils/correo.ts.
#
# La API key se saca de https://resend.com/api-keys
RESEND_API_KEY=""

# LÍMITE ACTUAL, IMPORTANTE:
# Con el front en gran-casino-cucuta1.onrender.com no se pueden crear registros
# DNS, y sin DNS propio no se puede verificar un dominio remitente. El
# remitente de pruebas de Resend (el de abajo) SOLO entrega al correo con el
# que se creó la cuenta de Resend — sirve para probar el flujo de punta a
# punta, no para clientes reales.
#
# Cuando exista dominio propio: verificarlo en Resend (SPF + DKIM) y cambiar
# esto por algo como "Gran Casino Cúcuta <no-responder@sudominio.com>".
RESEND_FROM="Gran Casino Cúcuta <onboarding@resend.dev>"
